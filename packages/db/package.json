{
  "name": "@aniradar/db",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "setup": "dotenv -e ../../.env -- prisma migrate deploy && dotenv -e ../../.env -- tsx prisma/seed.ts",
    "import:postgres": "dotenv -e ../../.env -- prisma migrate deploy && dotenv -e ../../.env -- tsx prisma/importPostgres.ts",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "check:sources": "dotenv -e ../../.env -- tsx prisma/checkSeedSources.ts",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@aniradar/shared": "workspace:*",
    "@aniradar/sources": "workspace:*",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prisma": "^6.19.0",
    "tsx": "^4.23.12"
  }
}
