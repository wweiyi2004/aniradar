{
  "name": "@aniradar/db",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --name init",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "check:sources": "dotenv -e ../../.env -- tsx prisma/checkSeedSources.ts",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@aniradar/shared": "workspace:*",
    "@aniradar/sources": "workspace:*",
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": { "prisma": "^5.20.0", "tsx": "^4.19.0" }
}
