# 相对 packages/db/prisma/schema.prisma，实际文件位于仓库根 data/aniradar.db。
DATABASE_URL="file:../../../data/aniradar.db"
# 一次性导入旧 PostgreSQL 时临时设置；平时留空。
POSTGRES_SOURCE_URL=""
SCHEDULER_INTERVAL_MS=30000
CRAWLER_USER_AGENT="AniRadarBot/0.1 (+https://example.com)"
CRAWLER_TIMEOUT_MS=30000
CRAWLER_MAX_RESPONSE_BYTES=5242880
ENRICH_MAX_PER_CYCLE=12
REANALYZE_INTERVAL_MS=600000
REANALYZE_WINDOW_HOURS=168
REANALYZE_BATCH=20
JOB_POLL_INTERVAL_MS=500
JOB_LOCK_TIMEOUT_MS=300000
WORKER_LEASE_TTL_MS=30000

# AI（DeepSeek，OpenAI 兼容；留空 AI_API_KEY 则使用规则 mock，项目仍可运行）
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com"
AI_MODEL="deepseek-chat"
# 是否也翻译"非动漫情报"条目的标题/摘要（默认开；设 false 则非情报保留原文）
AI_TRANSLATE_NON_NEWS="true"

# 后台鉴权（Basic Auth）。为空则 /admin 与 /api/admin 一律拒绝访问（fail-closed）。
ADMIN_USER="admin"
ADMIN_PASSWORD=""
# 对外访问源（用于 CSRF Origin 校验）。反代部署时设为 https://your.domain；本地可留空，回退 Host。
PUBLIC_ORIGIN=""

# 前台是否展示 AI 草稿 draft_ai（默认 false，仅后台可见；调试可设 true）
PUBLIC_SHOW_DRAFT="false"
